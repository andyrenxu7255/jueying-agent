        "kind": "weekly",
        "timezone": "Asia/Shanghai",
        "next_run_at": "2026-06-01T09:00:00+08:00",
        "cadence_label": "每周一 09:00"
      },
      "delegation_chain": [
        {
          "order": 1,
          "actor_type": "executive",
          "actor_id": "user_exec_lina",
          "responsibility": "定义经营目标、节奏和升级阈值。"
        },
        {
          "order": 2,
          "actor_type": "pm_agent",
          "actor_id": "pm_agent_ops_001",
          "responsibility": "拆解成销售、交付、信息补采和外部同步任务。"
        },
        {
          "order": 3,
          "actor_type": "sales_agent",
          "actor_id": "sales_agent_001",
          "responsibility": "检查商机 Gate、CRM 事实和下一步销售动作。"
        },
        {
          "order": 4,
          "actor_type": "human_twin_agent",
          "actor_id": "twin_sales_andy",
          "responsibility": "向销售同事追问缺失证据并收集反馈。"
        }
      ],
      "created_at": "2026-05-31T18:20:00+08:00"
    },
    {
      "id": "cmd_trigger_delivery_delay",
      "title": "外部项目延期超过 48 小时则触发升级",
      "status": "active",
      "trigger_type": "condition",
      "created_by_role_id": "role_exec_lina",
      "target_agent_id": "pm_agent_ops_001",
      "objective": "当项目管理系统出现延期、验收证据缺失或关键任务长时间未更新时，自动让交付 Agent 生成补救计划并派发信息采集。",
      "task_graph_id": "tg_sales_acme_001",
      "project_id": "proj_delivery_acceptance",
      "generated_task_ids": [
        "mtask_delivery_delay_recovery"
      ],
      "condition": {
        "signal": "project_management.task_overdue_hours",
        "operator": "greater_than",
        "threshold": "48",
        "evaluation_window": "rolling_24h"
      },
      "delegation_chain": [
        {
          "order": 1,
          "actor_type": "executive",
          "actor_id": "user_exec_lina",
          "responsibility": "设置延期升级标准和验收目标。"
        },
        {
          "order": 2,
          "actor_type": "pm_agent",
          "actor_id": "pm_agent_ops_001",
          "responsibility": "识别延期影响并重排 TaskGraph。"
        },
        {
          "order": 3,
          "actor_type": "delivery_agent",
          "actor_id": "delivery_agent_001",
          "responsibility": "生成客户责任、内部补救和验收证据任务。"
        },
        {
          "order": 4,
          "actor_type": "human",
          "actor_id": "user_pm_chen",
          "responsibility": "补充现场状态、客户确认和交付风险说明。"
        }
      ],
      "created_at": "2026-05-31T18:22:00+08:00",
      "last_triggered_at": "2026-05-31T18:25:00+08:00"
    },
    {
