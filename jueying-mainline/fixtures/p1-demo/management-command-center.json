        {
          "order": 1,
          "actor_type": "executive",
          "actor_id": "user_exec_lina",
          "responsibility": "提出经营意图和交付时间。"
        },
        {
          "order": 2,
          "actor_type": "pm_agent",
          "actor_id": "pm_agent_ops_001",
